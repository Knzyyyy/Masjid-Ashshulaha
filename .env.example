# Salin file ini menjadi .env (untuk deploy lokal / Vercel CLI).
# JANGAN commit file .env yang sudah diisi.
# Ambil nilainya dari Supabase Dashboard > Settings > API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Isi dengan key sb_publishable_ dari Supabase; placeholder ini sengaja gagal build.
SUPABASE_ANON_KEY=isi_dengan_publishable_key_anda
